<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.week2amantasksxml.fragments.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_detailsFragment"
            app:destination="@id/detailsFragment" />


    </fragment>
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.week2amantasksxml.fragments.DetailsFragment"
        android:label="DetailsFragment">
        <action
            android:id="@+id/action_detailsFragment_to_recyclerViewFragment"
            app:destination="@id/recyclerViewFragment" />
        <argument
            android:name="username"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/recyclerViewFragment"
        android:name="com.example.week2amantasksxml.fragments.RecyclerViewFragment"
        android:label="RecyclerViewFragment">
        <argument
            android:name="users"
            app:argType="com.example.week2amantasksxml.models.User[]" />
    </fragment>
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.week2amantasksxml.fragments.SplashFragment"
        android:label="SplashFragment">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.week2amantasksxml.fragments.LoginFragment"
        android:label="LoginFragment">
        <action
            android:id="@+id/action_loginFragment_to_recyclerViewFragment"
            app:destination="@id/recyclerViewFragment" />
    </fragment>

</navigation>